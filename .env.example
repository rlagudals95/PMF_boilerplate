## Core data storage
## Leave DATABASE_URL empty to use local JSON fallback.
## Neon is the recommended managed Postgres default, but any Postgres URL works.
DATABASE_URL=
LOCAL_DATA_FILE=packages/db/local-data.json

## Optional Supabase Auth starter for Google/Kakao
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=false

## Optional Naver OAuth starter
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

## Shared site/payment config
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Optional marketing providers
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_KAKAO_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_CONSULTATION=

## Optional payment provider
TOSS_PAYMENTS_API_KEY=

## Optional analytics provider
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_API_HOST=https://api.mixpanel.com
MIXPANEL_DEBUG=false
